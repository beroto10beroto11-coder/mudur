# =============================================================================
# SCHOOL SCHEDULER - Environment Variables
# =============================================================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
# cp .env.example .env
# =============================================================================

# -------------------------
# DATABASE
# -------------------------
POSTGRES_DB=school_scheduler
POSTGRES_USER=school_scheduler
POSTGRES_PASSWORD=changeme_strong_password_here
DATABASE_URL=postgresql+asyncpg://school_scheduler:changeme_strong_password_here@postgres:5432/school_scheduler
DATABASE_URL_SYNC=postgresql://school_scheduler:changeme_strong_password_here@postgres:5432/school_scheduler

# -------------------------
# REDIS
# -------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -------------------------
# JWT AUTH
# -------------------------
JWT_SECRET_KEY=changeme_very_long_random_secret_key_at_least_64_chars_long_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------
# BACKEND
# -------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
DEBUG=false
ENVIRONMENT=production

# Allowed origins for CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000

# -------------------------
# FRONTEND
# -------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# -------------------------
# BACKUP
# -------------------------
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=30
# Cron: every day at 03:00
BACKUP_SCHEDULE=0 3 * * *

# -------------------------
# SOLVER
# -------------------------
SOLVER_MAX_TIME_SECONDS=300
SOLVER_NUM_WORKERS=8

# -------------------------
# LOGGING
# -------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# -------------------------
# SUPER ADMIN (ilk kurulumda otomatik oluşturulur)
# -------------------------
FIRST_SUPERADMIN_EMAIL=admin@school.local
FIRST_SUPERADMIN_PASSWORD=changeme_admin_password_here
FIRST_SUPERADMIN_FULL_NAME=System Administrator
